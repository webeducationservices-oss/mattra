{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/rebates", "destination": "/financing-rebates", "statusCode": 301 },
    { "source": "/custom-homes-and-construction", "destination": "/construction", "statusCode": 301 },
    { "source": "/financing", "destination": "/financing-rebates", "statusCode": 301 },
    { "source": "/mold-remediation", "destination": "/mold/removal-remediation", "statusCode": 301 },
    { "source": "/income-based-eligibility-verification", "destination": "/financing-rebates", "statusCode": 301 },
    { "source": "/get-started", "destination": "/contact", "statusCode": 301 },
    { "source": "/air-sealing", "destination": "/insulation/air-sealing", "statusCode": 301 },
    { "source": "/project-portfolio/:id", "destination": "/services", "statusCode": 301 },
    { "source": "/projects", "destination": "/services", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://myaieditor.com https://myaiediter.com https://*.vercel.app http://localhost:3000 http://localhost:*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.+\\.(?:jpg|jpeg|png|gif|svg|webp|ico|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
